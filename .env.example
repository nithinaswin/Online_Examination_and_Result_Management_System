# Server
PORT=8080

# Database Configuration (MySQL / Aiven Cloud MySQL)
# Option 1: Full URL
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/exam_system?sslMode=PREFERRED&allowPublicKeyRetrieval=true&serverTimezone=UTC
# Option 2: Individual variables
DB_HOST=localhost
DB_PORT=3306
DB_NAME=exam_system
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_SSL_MODE=PREFERRED

# JWT Secret & Expiration (minimum 256 bits for HS256)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Bootstrap Initial Admin (Only created on first run if no admin exists)
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=AdminSecurePass123!
ADMIN_NAME=System Administrator

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-deployment.vercel.app

# Exam Engine
EXAM_GRACE_PERIOD_SECONDS=15
